---
import '../styles/global.css';
import type { FAQItem } from '../lib/seoContent';
import { getAlternates, getMessages, type Locale } from '../i18n';

interface Alternate {
	hreflang: string;
	href: string;
}

interface SoftwareMeta {
	name: string;
	alternateName?: string;
	operatingSystem: string;
	applicationCategory?: string;
	installUrl?: string;
	downloadUrl?: string;
	screenshots?: string[];
}

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	locale?: Locale;
	noindex?: boolean;
	alternates?: Alternate[];
	pageType?: 'home' | 'tool' | 'software' | 'article' | 'static';
	appName?: string;
	featureList?: readonly string[];
	software?: SoftwareMeta;
	faqs?: FAQItem[];
	datePublished?: string;
	dateModified?: string;
}

const locale: Locale = Astro.props.locale ?? 'zh-CN';
const m = getMessages(locale);

const {
	title,
	description = m.seo.defaultDescription,
	canonical,
	ogImage = locale === 'en' ? '/og-default-en.png' : '/og-default.png',
	noindex = false,
	alternates,
	pageType = 'static',
	appName,
	featureList,
	software,
	faqs,
	datePublished,
	dateModified = '2026-11-26',
} = Astro.props;

const BRAND = 'DetectRadar';
const fullTitle = !title || title === BRAND ? m.seo.defaultTitle : `${title}${m.seo.titleSep}${BRAND}`;

const site = Astro.site ?? new URL('https://detectradar.com');
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, site);
const resolvedAlternates = alternates ?? getAlternates(canonicalPath);
const ogImageURL = ogImage ? new URL(ogImage, site) : undefined;
const ogLocale = locale === 'en' ? 'en_US' : 'zh_CN';
const altOgLocale = locale === 'en' ? 'zh_CN' : 'en_US';

const ld = (o: Record<string, unknown>) => JSON.stringify(o).replace(/</g, '\\u003c');

const orgId = `${site.origin}/#organization`;
const websiteId = `${site.origin}/#website`;
const webpageId = `${canonicalURL.href}#webpage`;
const appId = `${canonicalURL.href}#app`;
const articleId = `${canonicalURL.href}#article`;
const faqId = `${canonicalURL.href}#faq`;

const graphNodes: Record<string, unknown>[] = [
	{
		'@type': 'Organization',
		'@id': orgId,
		name: BRAND,
		url: site.origin,
		logo: {
			'@type': 'ImageObject',
			url: new URL('/icon-192.png', site).href,
			width: 192,
			height: 192,
		},
		sameAs: ['https://github.com/harrisonwang/detect-radar'],
	},
	{
		'@type': 'WebSite',
		'@id': websiteId,
		name: BRAND,
		url: site.origin,
		inLanguage: ['zh-CN', 'en'],
		publisher: { '@id': orgId },
		...(pageType === 'home' ? { description } : {}),
	},
	{
		'@type': 'WebPage',
		'@id': webpageId,
		url: canonicalURL.href,
		name: fullTitle,
		description,
		inLanguage: locale,
		...(datePublished ? { datePublished } : {}),
		dateModified,
		isPartOf: { '@id': websiteId },
		about:
			pageType === 'home' || pageType === 'tool' || pageType === 'software'
				? { '@id': appId }
				: pageType === 'article'
					? { '@id': articleId }
					: { '@id': orgId },
		...(ogImageURL ? { primaryImageOfPage: { '@type': 'ImageObject', url: ogImageURL.href } } : {}),
	},
];

if (pageType === 'home' || pageType === 'tool') {
	graphNodes.push({
		'@type': 'WebApplication',
		'@id': appId,
		name: appName ?? (title ? `${BRAND} ${title}` : BRAND),
		url: canonicalURL.href,
		applicationCategory: 'SecurityApplication',
		operatingSystem: 'Any (Web browser)',
		browserRequirements: 'Requires JavaScript, HTML5',
		isAccessibleForFree: true,
		inLanguage: locale,
		license: 'https://opensource.org/licenses/MIT',
		codeRepository: 'https://github.com/harrisonwang/detect-radar',
		screenshot: (ogImageURL ?? new URL(locale === 'en' ? '/og-default-en.png' : '/og-default.png', site)).href,
		publisher: { '@id': orgId },
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		description,
		featureList: featureList ?? m.seo.defaultHomeFeatures,
	});
}

if (pageType === 'software') {
	const screenshots = software?.screenshots?.map((s) => new URL(s, site).href);
	graphNodes.push({
		'@type': 'SoftwareApplication',
		'@id': appId,
		name: software?.name ?? appName ?? (title ? `${BRAND} ${title}` : BRAND),
		...(software?.alternateName ? { alternateName: software.alternateName } : {}),
		url: canonicalURL.href,
		applicationCategory: software?.applicationCategory ?? 'UtilitiesApplication',
		operatingSystem: software?.operatingSystem ?? 'macOS 13.0 or later',
		isAccessibleForFree: true,
		inLanguage: locale,
		license: 'https://opensource.org/licenses/MIT',
		...(screenshots && screenshots.length > 0 ? { screenshot: screenshots } : {}),
		...(software?.installUrl ? { installUrl: software.installUrl } : {}),
		...(software?.downloadUrl ? { downloadUrl: software.downloadUrl } : {}),
		publisher: { '@id': orgId },
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		description,
	});
}

if (pageType === 'article') {
	graphNodes.push({
		'@type': 'TechArticle',
		'@id': articleId,
		headline: title ?? fullTitle,
		description,
		inLanguage: locale,
		...(datePublished ? { datePublished } : {}),
		dateModified,
		author: { '@id': orgId },
		publisher: { '@id': orgId },
		mainEntityOfPage: { '@id': webpageId },
	});
}

if (faqs && faqs.length > 0) {
	graphNodes.push({
		'@type': 'FAQPage',
		'@id': faqId,
		url: canonicalURL.href,
		inLanguage: locale,
		mainEntity: faqs.map((f) => ({
			'@type': 'Question',
			name: f.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: f.answer,
			},
		})),
	});
}

const jsonLdGraph = {
	'@context': 'https://schema.org',
	'@graph': graphNodes,
};

const analyticsSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const analyticsId = import.meta.env.PUBLIC_UMAMI_ID;
const menuOpenLabel = m.nav.openMenu;
const menuCloseLabel = m.nav.closeMenu;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="DetectRadar" />
		<meta name="theme-color" content="#020617" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
		<link rel="canonical" href={canonicalURL.href} />
		{resolvedAlternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, site).href} />)}
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM & Agent Documentation" />

		<meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
		<meta property="og:site_name" content="DetectRadar" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={altOgLocale} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		{pageType === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
		{pageType === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
		{ogImageURL && (
			<>
				<meta property="og:image" content={ogImageURL.href} />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta property="og:image:alt" content={fullTitle} />
			</>
		)}

		<meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		{ogImageURL && <meta name="twitter:image" content={ogImageURL.href} />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<meta name="generator" content={Astro.generator} />

		<script is:inline type="application/ld+json" set:html={ld(jsonLdGraph)} />

		{analyticsSrc && analyticsId && (
			<script is:inline defer src={analyticsSrc} data-website-id={analyticsId}></script>
		)}
	</head>
	<body class="min-h-screen selection:bg-(--radar-500) selection:text-(--space-950)">
		<slot />
		<script is:inline define:vars={{ menuOpenLabel, menuCloseLabel }}>
			(() => {
				const btn = document.querySelector('[data-nav-toggle="static"]');
				const nav = document.getElementById('site-nav');
				if (!btn || !nav) return;
				const header = btn.closest('header');
				const setOpen = (open) => {
					nav.classList.toggle('is-open', open);
					btn.classList.toggle('is-open', open);
					btn.setAttribute('aria-expanded', open ? 'true' : 'false');
					const label = open ? menuCloseLabel : menuOpenLabel;
					btn.setAttribute('aria-label', label);
					btn.setAttribute('title', label);
				};
				btn.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
				nav.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', () => setOpen(false));
				});
				document.addEventListener('pointerdown', (e) => {
					if (!nav.classList.contains('is-open')) return;
					if (header && e.target instanceof Node && !header.contains(e.target)) setOpen(false);
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && nav.classList.contains('is-open')) setOpen(false);
				});
			})();
		</script>
	</body>
</html>
