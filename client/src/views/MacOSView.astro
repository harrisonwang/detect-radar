---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/report/AppHeader.svelte';
import ReportBackdrop from '../components/ReportBackdrop.svelte';
import SiteFooter from '../components/SiteFooter.svelte';
import { getMessages, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = getMessages(locale);
const canonical = localePath('/macos/', locale);

const MACOS_VERSION = '0.1.2';
const MACOS_RELEASE_TAG = `macos-v${MACOS_VERSION}`;
const MACOS_DMG_FILENAME = `DetectRadarBar-v${MACOS_VERSION}-macos-universal.dmg`;

const GITHUB_RELEASES_URL = 'https://github.com/harrisonwang/detect-radar/releases';
const R2_DIRECT_DOWNLOAD_URL = `https://dl.detectradar.com/macos/releases/${MACOS_RELEASE_TAG}/${MACOS_DMG_FILENAME}`;

const ACTIVE_DOWNLOAD_CHANNEL = 'r2' as 'github' | 'r2';

const DOWNLOAD_CHANNELS = {
  github: {
    href: GITHUB_RELEASES_URL,
    label: m.macos.downloadLabel,
    ext: '',
    ariaLabel: m.macos.downloadGithubAria,
    isDirectFile: false,
    external: true,
    downloadAttr: undefined,
  },
  r2: {
    href: R2_DIRECT_DOWNLOAD_URL,
    label: m.macos.downloadLabel,
    ext: '.dmg',
    ariaLabel: m.macos.downloadDirectAria,
    isDirectFile: true,
    external: false,
    downloadAttr: MACOS_DMG_FILENAME,
  },
} as const;

const primaryDownload = DOWNLOAD_CHANNELS[ACTIVE_DOWNLOAD_CHANNEL];

const BREW_CMD = 'brew install --cask harrisonwang/tap/detectradar-bar';
const XATTR_CMD = 'xattr -cr /Applications/DetectRadarBar.app';
const SKILL_PATH = locale === 'en' ? '/en/SKILL.md' : '/SKILL.md';
const SKILL_URL = `https://detectradar.com${SKILL_PATH}`;
const AGENT_PROMPT = `${m.macos.agentPromptBefore}${SKILL_URL}${m.macos.agentPromptAfter}`;
const MODULES_REPO_URL = 'https://github.com/harrisonwang/detect-radar/tree/main/modules';
const MODULE_SUFFIX = locale === 'en' ? '-en' : '';
const PROXY_MODULES = [
  {
    name: 'Surge',
    ext: '.sgmodule',
    url: `https://raw.githubusercontent.com/harrisonwang/detect-radar/main/modules/surge/detectradar${MODULE_SUFFIX}.sgmodule`,
  },
  {
    name: 'Stash',
    ext: '.stoverride',
    url: `https://raw.githubusercontent.com/harrisonwang/detect-radar/main/modules/stash/detectradar${MODULE_SUFFIX}.stoverride`,
  },
  {
    name: 'Loon',
    ext: '.plugin',
    url: `https://raw.githubusercontent.com/harrisonwang/detect-radar/main/modules/loon/detectradar${MODULE_SUFFIX}.plugin`,
  },
] as const;

const PREVIEW_LANG_SUFFIX = locale === 'en' ? '-en' : '';
const PREVIEWS = [
  {
    id: 'clean-dark',
    label: m.macos.previews.darkLabel,
    src: `/images/macos-bar-preview-dark${PREVIEW_LANG_SUFFIX}-v3.png`,
    width: 672,
    height: 502,
    alt: m.macos.previews.darkAlt,
    alertDot: false,
  },
  {
    id: 'clean-light',
    label: m.macos.previews.lightLabel,
    src: `/images/macos-bar-preview-light${PREVIEW_LANG_SUFFIX}-v3.png`,
    width: 672,
    height: 502,
    alt: m.macos.previews.lightAlt,
    alertDot: false,
  },
  {
    id: 'alert-dark',
    label: m.macos.previews.alertLabel,
    src: `/images/macos-bar-preview-alert${PREVIEW_LANG_SUFFIX}-v3.png`,
    width: 672,
    height: 502,
    alt: m.macos.previews.alertAlt,
    alertDot: true,
  },
] as const;

const copiedFallback = m.macos.copiedFallback;
---

<Layout
  title={m.seo.macos.title}
  canonical={canonical}
  locale={locale}
  description={m.seo.macos.description}
  pageType="software"
  dateModified="2026-11-27"
  software={{
    name: 'DetectRadar for macOS',
    alternateName: 'DetectRadarBar',
    operatingSystem: 'macOS 13.0 or later',
    applicationCategory: 'UtilitiesApplication',
    softwareVersion: MACOS_VERSION,
    inLanguage: ['zh-CN', 'en'],
    ...(primaryDownload.isDirectFile
      ? { downloadUrl: primaryDownload.href }
      : { installUrl: primaryDownload.href }),
    screenshots: PREVIEWS.map((p) => p.src),
  }}
>
  <div class="min-h-screen bg-space-950 scan-grid flex flex-col relative">
    <ReportBackdrop />
    <AppHeader page="static" {locale} currentPath={canonical} />

    <main class="relative z-10 flex-1 mx-auto w-full max-w-[1104px] px-4 sm:px-6 lg:px-8 pt-8 pb-14 sm:pt-12 sm:pb-16 lg:pt-16 lg:pb-20 min-w-0">
      <section
        aria-label={m.macos.heroAria}
        class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(380px,440px)] gap-10 lg:gap-14 items-start"
      >
        <div class="min-w-0 lg:pt-5">
          <p class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-mono text-(--slate-400)">
            <i class="fa-brands fa-apple text-[13px] text-(--slate-300)" aria-hidden="true"></i>
            <span>macOS 13+</span>
            <span aria-hidden="true" class="text-slate-600">·</span>
            <span>Apple Silicon / Intel</span>
          </p>

          <h1 class="mt-3.5 text-3xl sm:text-[2.375rem] font-bold text-white tracking-[-0.025em] leading-[1.15]">
            DetectRadar for macOS
          </h1>

          <p class="mt-4 text-[15px] leading-[1.7] text-(--slate-300) max-w-lg">
            {m.macos.subtitle}
          </p>

          <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-3">
            <a
              href={primaryDownload.href}
              target={primaryDownload.external ? '_blank' : undefined}
              rel={primaryDownload.external ? 'noopener noreferrer' : undefined}
              download={primaryDownload.downloadAttr}
              aria-label={primaryDownload.ariaLabel}
              class="primary-cta inline-flex items-center justify-center gap-2 w-full sm:w-auto h-11 px-5 rounded-xl bg-(--radar-400) text-(--space-950) text-sm font-semibold tracking-[-0.01em] hover:bg-[#5ee890] active:translate-y-[0.5px] transition-all"
            >
              <i class="fa-solid fa-download text-xs" aria-hidden="true"></i>
              <span>{primaryDownload.label}</span>
              {primaryDownload.ext && (
                <span class="font-mono text-xs opacity-70">{primaryDownload.ext}</span>
              )}
            </a>

            {ACTIVE_DOWNLOAD_CHANNEL === 'r2' && (
              <a
                href={GITHUB_RELEASES_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-(--slate-400) hover:text-white transition-colors sm:ml-1 text-center sm:text-left"
              >
                {m.macos.releaseHistory}
              </a>
            )}
          </div>

          <div class="mt-6">
            <p class="text-xs text-(--slate-400) mb-2">{m.macos.brewLead}</p>
            <div class="cmd-strip flex items-center gap-2.5 rounded-xl border border-slate-800/90 bg-[#070d1b]/85 px-3.5 py-2.5">
              <span aria-hidden="true" class="font-mono text-xs text-slate-500 select-none shrink-0">$</span>
              <code class="flex-1 min-w-0 overflow-x-auto whitespace-nowrap font-mono text-[12.5px] sm:text-[13px] text-(--slate-200) select-all">
                {BREW_CMD}
              </code>
              <button
                type="button"
                data-copy-cmd={BREW_CMD}
                data-copy-announce={m.macos.brewCopied}
                class="copy-btn shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-800 bg-slate-900/90 text-(--slate-300) hover:text-white hover:border-slate-600 transition-colors cursor-pointer"
                title={m.macos.brewCopyTitle}
                aria-label={m.macos.brewCopyTitle}
              >
                <i data-copy-icon class="fa-regular fa-copy text-[13px]" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <details class="gatekeeper-tip group mt-3.5">
            <summary class="inline-flex items-center gap-1.5 text-xs text-(--slate-400) hover:text-(--slate-200) transition-colors cursor-pointer list-none select-none">
              <i class="tip-chevron fa-solid fa-chevron-right text-[9px] text-slate-500 transition-transform duration-150" aria-hidden="true"></i>
              <span>{m.macos.gatekeeperSummary}</span>
            </summary>
            <div class="mt-2.5 pl-3.5 border-l border-slate-800 space-y-2">
              <p class="text-xs leading-6 text-(--slate-400)">
                {m.macos.gatekeeperBody}
              </p>
              <div class="cmd-strip flex items-center gap-2 rounded-lg border border-slate-800/90 bg-[#070d1b]/80 px-3 py-2">
                <span aria-hidden="true" class="font-mono text-xs text-slate-500 select-none shrink-0">$</span>
                <code class="flex-1 min-w-0 overflow-x-auto whitespace-nowrap font-mono text-[12px] text-(--slate-300) select-all">
                  {XATTR_CMD}
                </code>
                <button
                  type="button"
                  data-copy-cmd={XATTR_CMD}
                  data-copy-announce={m.macos.gatekeeperCopied}
                  class="copy-btn shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-md border border-slate-800 bg-slate-900/90 text-(--slate-400) hover:text-white hover:border-slate-600 transition-colors cursor-pointer"
                  title={m.macos.gatekeeperCopyTitle}
                  aria-label={m.macos.gatekeeperCopyTitle}
                >
                  <i data-copy-icon class="fa-regular fa-copy text-[12px]" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </details>
        </div>

        <figure class="min-w-0 w-full max-w-[440px] mx-auto lg:mx-0">
          <div
            id="macos-preview-stage"
            data-state="clean-dark"
            class="preview-stage grid"
          >
            {PREVIEWS.map((item, idx) => (
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading={idx === 0 ? 'eager' : 'lazy'}
                fetchpriority={idx === 0 ? 'high' : undefined}
                decoding="async"
                data-stage-img={item.id}
                aria-hidden={idx === 0 ? undefined : 'true'}
                class:list={[
                  'preview-layer col-start-1 row-start-1 w-full h-auto block',
                  idx === 0 && 'is-active',
                ]}
              />
            ))}
          </div>

          <div class="mt-4 flex justify-center">
            <div
              role="group"
              aria-label={m.macos.previewGroupAria}
              class="inline-flex items-center gap-0.5 rounded-xl border border-white/[0.08] bg-[#0a1120]/90 p-1 backdrop-blur-sm max-w-full"
            >
              {PREVIEWS.map((item, idx) => (
                <button
                  type="button"
                  data-stage-tab={item.id}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                  class:list={[
                    'stage-tab inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 min-h-8 text-xs font-medium whitespace-nowrap transition-colors cursor-pointer',
                    idx === 0 && 'is-active',
                  ]}
                >
                  {item.alertDot && (
                    <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-(--warn) shrink-0"></span>
                  )}
                  <span>{item.label}</span>
                </button>
              ))}
            </div>
          </div>
        </figure>
      </section>

      <section
        aria-labelledby="agent"
        class="mt-12 sm:mt-16 pt-8 sm:pt-10 border-t border-white/[0.08] grid grid-cols-1 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] gap-5 lg:gap-12 items-center"
      >
        <div class="min-w-0">
          <p class="inline-flex items-center gap-2 text-xs text-(--slate-400)">
            <span class="dot bg-(--radar-400)" style="--_soft: var(--sig-soft);" aria-hidden="true"></span>
            <span>{m.macos.agentTag}</span>
            <span aria-hidden="true" class="text-slate-700">·</span>
            <a href={SKILL_PATH} class="font-mono text-[11px] text-(--slate-400) hover:text-white transition-colors">SKILL.md ↗</a>
          </p>
          <h2 id="agent" class="mt-2 text-lg font-semibold text-white tracking-[-0.01em]">
            {m.macos.agentHeading}
          </h2>
          <p class="mt-1.5 text-[13.5px] leading-6 text-(--slate-400)">
            {m.macos.agentDesc}
          </p>
        </div>

        <div class="min-w-0">
          <div class="cmd-strip flex flex-col sm:flex-row sm:items-center gap-3 rounded-xl border border-slate-800/90 bg-[#070d1b]/85 px-4 py-3">
            <div class="flex items-start gap-2.5 flex-1 min-w-0">
              <span aria-hidden="true" class="font-mono text-xs text-(--radar-400) select-none shrink-0 mt-1">&gt;</span>
              <p class="flex-1 min-w-0 text-[13.5px] leading-6 text-(--slate-200) break-words select-all">
                {m.macos.agentPromptBefore}<span class="inline font-mono text-[12.5px] sm:text-[13px] text-(--radar-400) break-all sm:break-normal">{SKILL_URL}</span>{m.macos.agentPromptAfter}
              </p>
            </div>
            <button
              type="button"
              data-copy-cmd={AGENT_PROMPT}
              data-copy-announce={m.macos.agentCopied}
              class="copy-btn self-end sm:self-center shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-800 bg-slate-900/90 text-(--slate-300) hover:text-white hover:border-slate-600 transition-colors cursor-pointer"
              title={m.macos.agentCopyTitle}
              aria-label={m.macos.agentCopyTitle}
            >
              <i data-copy-icon class="fa-regular fa-copy text-[13px]" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </section>

      <section
        aria-labelledby="proxy-modules"
        class="mt-10 sm:mt-12 pt-8 sm:pt-10 border-t border-white/[0.08] grid grid-cols-1 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] gap-5 lg:gap-12 items-start lg:items-center"
      >
        <div class="min-w-0">
          <p class="inline-flex items-center gap-2 text-xs text-(--slate-400)">
            <span class="dot bg-(--slate-400)" style="--_soft: var(--unknown-soft);" aria-hidden="true"></span>
            <span>{m.macos.modulesTag}</span>
            <span aria-hidden="true" class="text-slate-700">·</span>
            <a
              href={MODULES_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] text-(--slate-400) hover:text-white transition-colors"
            >
              modules/ ↗
            </a>
          </p>
          <h2 id="proxy-modules" class="mt-2 text-lg font-semibold text-white tracking-[-0.01em]">
            {m.macos.modulesHeading}
          </h2>
          <p class="mt-1.5 text-[13.5px] leading-6 text-(--slate-400)">
            {m.macos.modulesDesc}
          </p>
        </div>

        <div class="min-w-0 grid grid-cols-1 sm:grid-cols-3 gap-2.5">
          {PROXY_MODULES.map((mod) => (
            <div class="cmd-strip flex items-center justify-between gap-2.5 rounded-xl border border-slate-800/90 bg-[#070d1b]/85 px-3.5 py-2.5 min-w-0">
              <div class="min-w-0">
                <p class="text-[13px] font-medium text-(--slate-200) leading-tight">{mod.name}</p>
                <p class="mt-0.5 font-mono text-[11px] text-(--slate-500) truncate">{mod.ext}</p>
              </div>
              <button
                type="button"
                data-copy-cmd={mod.url}
                data-copy-announce={m.macos.moduleCopied(mod.name)}
                class="copy-btn shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-800 bg-slate-900/90 text-(--slate-300) hover:text-white hover:border-slate-600 transition-colors cursor-pointer"
                title={m.macos.moduleCopyTitle(mod.name)}
                aria-label={m.macos.moduleCopyTitle(mod.name)}
              >
                <i data-copy-icon class="fa-regular fa-copy text-[13px]" aria-hidden="true"></i>
              </button>
            </div>
          ))}
        </div>
      </section>

      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </main>

    <SiteFooter {locale} />
  </div>

  <style>
    .primary-cta {
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.28) inset,
        0 10px 28px -8px rgba(74, 222, 128, 0.42);
    }
    .primary-cta:focus-visible,
    .copy-btn:focus-visible,
    .stage-tab:focus-visible,
    .gatekeeper-tip summary:focus-visible {
      outline: 2px solid var(--radar-400);
      outline-offset: 2px;
    }
    .cmd-strip {
      transition: border-color 160ms ease;
    }
    .cmd-strip:hover {
      border-color: rgba(71, 85, 105, 0.9);
    }
    .copy-btn.is-copied {
      border-color: rgba(74, 222, 128, 0.42);
      background: rgba(74, 222, 128, 0.1);
      color: var(--radar-400);
    }
    .gatekeeper-tip summary::-webkit-details-marker {
      display: none;
    }
    .gatekeeper-tip[open] .tip-chevron {
      transform: rotate(90deg);
    }

    .preview-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 672 / 502;
      border-radius: 1rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.11);
      background: #0e1420;
      box-shadow:
        0 24px 60px -16px rgba(2, 6, 23, 0.85),
        0 0 44px -18px rgba(74, 222, 128, 0.15);
      transition:
        background-color 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
    }
    .preview-stage[data-state='clean-light'] {
      background: #d9e2ef;
      border-color: rgba(255, 255, 255, 0.22);
      box-shadow:
        0 24px 60px -16px rgba(2, 6, 23, 0.85),
        0 0 44px -18px rgba(148, 163, 184, 0.18);
    }
    .preview-stage[data-state='alert-dark'] {
      background: #0e1420;
      border-color: rgba(251, 191, 36, 0.28);
      box-shadow:
        0 24px 60px -16px rgba(2, 6, 23, 0.85),
        0 0 48px -16px rgba(251, 191, 36, 0.2);
    }

    .preview-layer {
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }
    .preview-layer.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .stage-tab {
      color: var(--slate-400);
    }
    .stage-tab:hover {
      color: var(--slate-200);
    }
    .stage-tab.is-active {
      background: rgba(30, 41, 59, 0.92);
      color: #fff;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }

    @media (prefers-reduced-motion: reduce) {
      .preview-stage,
      .preview-layer,
      .tip-chevron {
        transition: none;
      }
    }
  </style>

  <script is:inline define:vars={{ copiedFallback }}>
    (() => {
      const statusRegion = document.querySelector('[data-copy-status]');

      document.querySelectorAll('[data-copy-cmd]').forEach((btn) => {
        let timer;
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-copy-cmd') || '';
          const announce = btn.getAttribute('data-copy-announce') || copiedFallback;
          const icon = btn.querySelector('[data-copy-icon]');
          if (!cmd) return;
          try {
            if (!navigator.clipboard?.writeText) return;
            await navigator.clipboard.writeText(cmd);
            btn.classList.add('is-copied');
            if (icon) {
              icon.classList.remove('fa-regular', 'fa-copy');
              icon.classList.add('fa-solid', 'fa-check');
            }
            if (statusRegion) statusRegion.textContent = announce;
            clearTimeout(timer);
            timer = setTimeout(() => {
              btn.classList.remove('is-copied');
              if (icon) {
                icon.classList.remove('fa-solid', 'fa-check');
                icon.classList.add('fa-regular', 'fa-copy');
              }
            }, 1600);
          } catch {
          }
        });
      });

      const stage = document.getElementById('macos-preview-stage');
      const tabs = Array.from(document.querySelectorAll('[data-stage-tab]'));
      const imgs = Array.from(document.querySelectorAll('[data-stage-img]'));

      const warmImages = () => {
        imgs.forEach((img) => {
          if (img.getAttribute('loading') === 'lazy') {
            img.setAttribute('loading', 'eager');
          }
        });
      };

      if (stage && tabs.length && imgs.length) {
        const activate = (id) => {
          stage.setAttribute('data-state', id);
          imgs.forEach((img) => {
            const active = img.getAttribute('data-stage-img') === id;
            img.classList.toggle('is-active', active);
            if (active) img.removeAttribute('aria-hidden');
            else img.setAttribute('aria-hidden', 'true');
          });
          tabs.forEach((tab) => {
            const active = tab.getAttribute('data-stage-tab') === id;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        };

        tabs.forEach((tab) => {
          tab.addEventListener('pointerenter', warmImages, { once: true });
          tab.addEventListener('focus', warmImages, { once: true });
          tab.addEventListener('click', () => {
            const id = tab.getAttribute('data-stage-tab');
            if (id) activate(id);
          });
        });

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(warmImages, { timeout: 2500 });
        } else {
          window.addEventListener('load', warmImages, { once: true });
        }
      }
    })();
  </script>
</Layout>
