# DetectRadar 前端环境变量
# 复制为 .env 并按需修改。仅 PUBLIC_ 前缀的变量会暴露到浏览器。

# 后端 API 根地址（不含 /api/v1）。生产环境留空则使用同源 /api/ 反代；开发环境默认 http://127.0.0.1:8080
# 生产部署示例：PUBLIC_API_BASE=https://api.detectradar.com
PUBLIC_API_BASE=

# 自托管 cookieless 分析（Umami / Plausible）。两者都设了才注入分析脚本；留空则不加载任何第三方脚本。
# 生产环境把下面两行写进 .env.production（astro build 默认 mode=production，会自动加载）。
# PUBLIC_UMAMI_SRC=
# PUBLIC_UMAMI_ID=你的-website-id

# 诊断卡片底部合作推荐位（默认关闭；设为 true 或 1 时开启）
# PUBLIC_PARTNER_ENABLED=false
# PUBLIC_PARTNER_URL=https://proxy-seller.com/
# PUBLIC_PARTNER_CODE=RADAR
