############ 必填 ############
# 站点域名（A 记录将自动指向本机；可以是子域，如 radar.example.com）
DOMAIN=radar.example.com
# Cloudflare API Token：权限 Zone→DNS→Edit + Zone→Zone→Read，作用域限定到域名所在 zone
# 创建入口：https://dash.cloudflare.com/profile/api-tokens（模板选「编辑区域 DNS」）
CF_Token=
# Let's Encrypt 账户邮箱（证书到期提醒）
ACME_EMAIL=

############ 选填：网络 ############
# 公网 IPv4；auto = 自动探测
SERVER_IPV4=auto
# 公网 IPv6；留空 = 不发布 AAAA 记录
SERVER_IPV6=
# CoreDNS 监听的本机网卡 IP；auto = 取默认路由源地址。
# 云厂商 NAT 机型（AWS/GCP/Oracle 等）公网 IP 不在网卡上，此值≠SERVER_IPV4，auto 会正确处理
DNS_LISTEN_IP=auto
# 服务器经纬度：RTT 地理-延迟物理校验的锚点；留空 = 按公网 IP 自动定位。
# 定位失败时 setup 会明确报错，此时再手工填写
SERVER_LAT=
SERVER_LON=

############ 选填：第三方 IP 情报 key（均可留空，留空只降低判定准确率，不影响启动） ############
IPAPIIS_KEY=
BIGDATACLOUD_KEY=
IPREGISTRY_KEY=
IP2LOCATION_KEY=
CLOUDFLARE_RADAR_TOKEN=

############ 选填：镜像源与版本 ############
# 国内机器换成阿里云 ACR 镜像源（去掉注释即可）：
# REGISTRY=registry.cn-shenzhen.aliyuncs.com/harrisonwang
# COREDNS_IMAGE=registry.cn-shenzhen.aliyuncs.com/harrisonwang/coredns:1.12.1
# ACME_IMAGE=registry.cn-shenzhen.aliyuncs.com/harrisonwang/acme-sh:latest
REGISTRY=ghcr.io/harrisonwang
TAG=latest
CRAWLER_TAG=latest
# 爬虫更新周期（秒），默认一天
CRAWL_INTERVAL=86400
